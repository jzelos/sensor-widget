<Window x:Class="SensorWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sensor Widget"
        Width="340"
        MaxHeight="600"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="#E6E6E6"
        FontSize="13"
        MouseLeftButtonDown="OnWindowMouseLeftButtonDown">
    <Border BorderBrush="#444444" BorderThickness="1" Padding="10,6,10,10">
        <StackPanel>
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right"
                        AutomationProperties.AutomationId="close-button"
                        AutomationProperties.Name="Close"
                        Content="&#x2715;"
                        Width="24"
                        Height="24"
                        Background="Transparent"
                        Foreground="#E6E6E6"
                        BorderThickness="0"
                        Click="OnCloseButtonClick" />
                <TextBlock Text="Sensors" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ItemsControl ItemsSource="{Binding ReadingGroups}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#9CCBFF" />
                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="4,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTooHot}" Value="True">
                                                            <Setter Property="Background" Value="#C62828" />
                                                            <Setter Property="TextElement.Foreground" Value="White" />
                                                            <Setter Property="TextElement.FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding DisplayValue}" Margin="8,0,0,0" />
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
